{
  "name": "careercode-academy-root",
  "version": "1.0.0",
  "private": true,
  "description": "CareerCode Academy - Root dev orchestrator",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:env": "npm run test:env --workspace=backend && npm run test:env --workspace=frontend",
    "test:env": "npm run test:env --workspace=backend && npm run test:env --workspace=frontend",
    "env:check": "npm run test:env",
    "start": "npm run dev:all",
    "start:backend": "npm run dev --workspace=backend",
    "start:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "install:all": "npm install --workspace=backend && npm install --workspace=frontend",
    "migrate": "npm run migrate --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "seed:all": "npm run seed --workspace=backend && npm run seed:schools --workspace=backend && npm run seed:admin --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
